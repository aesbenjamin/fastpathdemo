# Copie para .env.local. O site grava as melodias direto no AuraDB (WebSocket seguro).
VITE_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
VITE_NEO4J_USER=neo4j
VITE_NEO4J_PASSWORD=

# API local do palco (também pode ser passada na URL: ?api=http://localhost:8000)
VITE_API_URL=http://localhost:8000

# URL pública que vai no QR code quando o palco roda em localhost
# VITE_PUBLIC_URL=https://seu-usuario.github.io/fastpath-music/
