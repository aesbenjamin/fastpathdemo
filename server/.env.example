# AuraDB (o mesmo banco que o site usa)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# AURA_INSTANCE_ID=xxxxxxxx   # opcional: se definido, a sessão AGA usa o id em vez da URI

# Aura Graph Analytics (Aura Console > Account > API keys)
FASTPATH_BACKEND=aga            # aga | local
FASTPATH_FALLBACK_LOCAL=true    # se a sessão AGA falhar, usa o FastPath local simulado
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=
AURA_PROJECT_ID=
GDS_SESSION_NAME=fastpath-music
GDS_SESSION_MEMORY=2GB
GDS_SESSION_TTL_MIN=180
GDS_ARROW_TIMEOUT_S=180         # VPNs como Cloudflare WARP levam ~45 s para abrir a conexão Arrow

# IA generativa (opcional: sem chave, textos de reserva são usados)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# FastPath (valores ajustados com scripts/tune.py)
# FP_DIMENSION=64
# FP_TIME_ANCHORS=20
# FP_SMOOTHING_WINDOW=1
# FP_DECAY_RATE=0.0
# FP_RANDOM_SEED=42
